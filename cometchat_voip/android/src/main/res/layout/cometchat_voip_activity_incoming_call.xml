<?xml version="1.0" encoding="utf-8"?>
<!--
  The ring screen over the keyguard. Plain and self-contained: it renders with
  no theme from the app, no image loading and no data binding, because it is
  drawn on a process that may be seconds old.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cometchat_voip_call_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <TextView
            android:id="@+id/cometchat_voip_initials"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:background="@drawable/cometchat_voip_bg_avatar_circle"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:textColor="@color/cometchat_voip_call_avatar_text"
            android:textSize="40sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cometchat_voip_caller_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="@color/cometchat_voip_call_text"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/cometchat_voip_call_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/cometchat_voip_call_text_secondary"
            android:textSize="16sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:baselineAligned="false"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingBottom="72dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/cometchat_voip_decline"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/cometchat_voip_bg_button_decline"
                android:contentDescription="@string/cometchat_voip_action_decline"
                android:scaleType="center"
                android:src="@drawable/cometchat_voip_ic_call_end" />

            <TextView
                android:id="@+id/cometchat_voip_decline_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/cometchat_voip_action_decline"
                android:textColor="@color/cometchat_voip_call_decline_label"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/cometchat_voip_answer"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/cometchat_voip_bg_button_accept"
                android:contentDescription="@string/cometchat_voip_action_answer"
                android:scaleType="center"
                android:src="@drawable/cometchat_voip_ic_call" />

            <TextView
                android:id="@+id/cometchat_voip_answer_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/cometchat_voip_action_answer"
                android:textColor="@color/cometchat_voip_call_accept_label"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
